# Example bounded job; source/destination, account and configuration require review.
# /etc/capstone/backup.conf is literal data and must contain the intended owned paths.
[Unit]
Description=ENos CAPSTONE Backup example
After=local-fs.target

[Service]
Type=oneshot
User=capstone
Group=capstone
WorkingDirectory=/opt/ENos/SEM06/scripts/projects/backup
ExecStart=/bin/bash /opt/ENos/SEM06/scripts/projects/backup/backup.sh --config /etc/capstone/backup.conf --source /srv/capstone/source --dest /var/lib/capstone-backup --type daily --incremental --compression gz --retention-daily 7 --log-file /dev/stderr
RuntimeDirectory=capstone-backup
StateDirectory=capstone-backup
Environment="LOCK_FILE=/run/capstone-backup/backup.lock"
TimeoutStartSec=3600
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/run/capstone-backup /var/lib/capstone-backup

[Install]
WantedBy=multi-user.target
