# Example unit; provision user, paths and literal configuration before activation.
# Copying/starting a unit is an explicit host operation, not part of local checks.
[Unit]
Description=ENos CAPSTONE Monitor example
After=local-fs.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=capstone
Group=capstone
WorkingDirectory=/opt/ENos/SEM06/scripts/projects/monitor
ExecStart=/bin/bash /opt/ENos/SEM06/scripts/projects/monitor/monitor.sh --config /etc/capstone/monitor.conf --daemon --interval 60 --output json --log-file /dev/stderr
Restart=on-failure
RestartSec=30
RuntimeDirectory=capstone-monitor
Environment="RUN_DIR=/run/capstone-monitor"
Environment="LOCK_FILE=/run/capstone-monitor/monitor.lock"
Environment="NOTIFY_EMAIL=" "NOTIFY_SLACK_WEBHOOK="
Environment="LOG_LEVEL=INFO" "THRESHOLD_CPU=80" "THRESHOLD_MEM=85" "THRESHOLD_DISK=90"
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/run/capstone-monitor
MemoryMax=100M
CPUQuota=10%

[Install]
WantedBy=multi-user.target
