' Baseline translation marker retained in Git history; source reviewed in phase 5.
@startuml dining_philosophers
!include ../../../00_SUPPLEMENTARY/diagrams_common/skin.puml
title Dining Philosophers Problem - Deadlock

skinparam rectangle {
    roundCorner 50
}

' Round table
circle "**TABLE**" as table #FFF9C4

' Philosophers
rectangle "**P0**\n🤔" as p0 #E3F2FD
rectangle "**P1**\n🤔" as p1 #E3F2FD
rectangle "**P2**\n🤔" as p2 #E3F2FD
rectangle "**P3**\n🤔" as p3 #E3F2FD
rectangle "**P4**\n🤔" as p4 #E3F2FD

' Forks
rectangle "F0\n🍴" as f0 #C8E6C9
rectangle "F1\n🍴" as f1 #C8E6C9
rectangle "F2\n🍴" as f2 #C8E6C9
rectangle "F3\n🍴" as f3 #C8E6C9
rectangle "F4\n🍴" as f4 #C8E6C9

' Circular arrangement
p0 -[hidden]down- table
p1 -[hidden]down- table
p2 -[hidden]down- table
p3 -[hidden]down- table
p4 -[hidden]down- table

' Holds (solid) - each has picked up left fork
f0 -[#27AE60,bold]-> p0 : allocated to
f1 -[#27AE60,bold]-> p1 : allocated to
f2 -[#27AE60,bold]-> p2 : allocated to
f3 -[#27AE60,bold]-> p3 : allocated to
f4 -[#27AE60,bold]-> p4 : allocated to

' Waits (dashed) - each wants right fork
p0 -[#E74C3C,dashed]-> f1 : waits
p1 -[#E74C3C,dashed]-> f2 : waits
p2 -[#E74C3C,dashed]-> f3 : waits
p3 -[#E74C3C,dashed]-> f4 : waits
p4 -[#E74C3C,dashed]-> f0 : waits

note bottom
**DEADLOCK!**
Cycle: P0→F1→P1→F2→P2→F3→P3→F4→P4→F0→P0

**Solutions:**
1. Asymmetric: P4 picks up right fork first
2. Limit: Max 4 philosophers at table
3. All-or-nothing: Pick up both or none
4. Arbiter: A waiter coordinates
end note

legend right
|= Line |= Meaning |
|<#27AE60> solid| Resource → holder |
|<#E74C3C> dashed| Requester → resource |
endlegend

@enduml
