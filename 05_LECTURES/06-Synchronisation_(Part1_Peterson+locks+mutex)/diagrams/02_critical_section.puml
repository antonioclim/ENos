@startuml critical_section
!include ../../../00_SUPPLEMENTARY/diagrams_common/skin.puml
title Critical Section - Repeated Protocol and Properties

skinparam activity {
    BackgroundColor #FAFAFA
    DiamondBackgroundColor #FFF9C4
}

start

repeat

partition "**ENTRY SECTION**" #E3F2FD {
    :acquire(lock)
    or lock(mutex);
    note right
    Request access
    May **block**
    end note
}

partition "**CRITICAL SECTION**" #FFCDD2 {
    :Access the shared
    resource
    (e.g. counter++);
    note right #FFCDD2
    ⚠️ **MAXIMUM ONE PROCESS**
    at any given time!
    end note
}

partition "**EXIT SECTION**" #C8E6C9 {
    :release(lock)
    or unlock(mutex);
    note right
    Release
    access
    end note
}

partition "**REMAINDER SECTION**" #FFFFFF {
    :Code that does not access
    the shared resource;
}

repeat while (true) is (always)
detach

legend right
**The 3 Necessary Properties:**

|= Property |= Description |
| **Mutual Exclusion** | Only one process in CS |
| **Progress** | Contending processes can decide who enters |
| **Bounded Waiting** | Bound on overtaking (under stated scheduling assumptions) |
endlegend

@enduml
