@startuml virtual_address_space
!include ../../../00_SUPPLEMENTARY/diagrams_common/skin.puml
title Virtual Address Space — Linux x86-64, four-level / 48-bit address example

skinparam rectangle {
    roundCorner 3
}

rectangle "**VIRTUAL ADDRESS SPACE**" as vas #FAFAFA {
    
    rectangle "0xFFFFFFFFFFFFFFFF\n**KERNEL SPACE**\n128 TiB" as kernel #FFE0B2 {
        note as kernel_contents
        • Kernel code
        • Drivers
        • Page tables
        end note
    }
    
    rectangle "**NON-CANONICAL GAP**\n(invalid addresses)\nInvalid canonical-address form" as gap #FFCDD2
    
    rectangle "**USER SPACE** 128 TiB" as user #E3F2FD {
        
        rectangle "**STACK** ↓\nStack limit is configurable" as stack #FFCDD2 {
            note as stack_contents
            Local variables
            Function parameters
            Return addresses
            end note
        }

        
        rectangle "**MEMORY MAPPED**\n.so libraries\nmmap() regions" as mmap #E1BEE7

        
        rectangle "**HEAP** ↑\nmalloc(), new" as heap #FFF9C4 {
            note as heap_contents
            Dynamic allocation
            brk() may extend; mmap() also used
            end note
        }
        
        rectangle "**BSS**\nUninitialised global vars\n(zeroed)" as bss #C8E6C9
        
        rectangle "**DATA**\nInitialised global vars" as data #C8E6C9
        
        rectangle "**TEXT (CODE)**\nRead-only, Exec" as text #BBDEFB {
            note as code_contents
            Instructions
            Read-only file-backed pages may be shared
            end note
        }
        
        rectangle "0x00000000\n**RESERVED**\nNULL region" as reserved_null #ECEFF1
    }
}

stack -[hidden]down-> mmap
mmap -[hidden]down-> heap
heap -[hidden]down-> bss
bss -[hidden]down-> data
data -[hidden]down-> text
text -[hidden]down-> reserved_null

kernel -[hidden]down-> gap
gap -[hidden]down-> user

note bottom of vas
**Linux visualisation:** cat /proc/PID/maps
Private mappings are per-process; explicit shared mappings are possible.
ASLR, ABI, page-table depth and resource limits change actual addresses/sizes.
end note

@enduml
